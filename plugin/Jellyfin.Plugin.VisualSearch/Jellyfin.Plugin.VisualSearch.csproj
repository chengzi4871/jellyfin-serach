<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Jellyfin.Plugin.VisualSearch</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.VisualSearch</AssemblyName>
    <Version>0.1.0.8</Version>
    <AssemblyVersion>0.1.0.8</AssemblyVersion>
    <FileVersion>0.1.0.8</FileVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- Jellyfin loads plugin dependencies from the plugin directory, not from the host app. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.6" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Web\visual-search.js" />
    <EmbeddedResource Include="Web\configPage.html" />
  </ItemGroup>
</Project>

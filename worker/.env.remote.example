# The endpoint must support text and image inputs in one vector space.
EMBEDDING_PROVIDER=remote
REMOTE_EMBEDDING_BASE_URL=https://your-provider.example/v1
# Alternatively set the complete endpoint instead of BASE_URL:
# REMOTE_EMBEDDING_URL=https://your-provider.example/v1/embeddings
REMOTE_EMBEDDING_API_KEY=replace-me
REMOTE_EMBEDDING_MODEL=your-multimodal-embedding-model
REMOTE_EMBEDDING_MODEL_VERSION=your-multimodal-embedding-model
REMOTE_EMBEDDING_DIMENSION=1024
REMOTE_EMBEDDING_PROTOCOL=openai_multimodal
REMOTE_EMBEDDING_TIMEOUT=30
REMOTE_EMBEDDING_RETRIES=2
QDRANT_URL=http://192.168.1.20:6333
